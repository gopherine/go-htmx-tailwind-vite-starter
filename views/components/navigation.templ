package components

templ Navigation() {
	<section class="sticky top-0 z-50 w-full border-b border-slate-200/60 bg-white/80 backdrop-blur">
		<div class="mx-auto flex w-full max-w-6xl flex-col items-center justify-between gap-6 px-6 py-10 md:flex-row md:py-8">
			<div class="flex items-center gap-4">
				<a href="/" class="flex items-center gap-3 font-semibold text-slate-900">
					<span class="shrink-0">
						@LogoMark()
					</span>
					<span class="text-lg tracking-tight">teddy</span>
				</a>
				<span class="hidden rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-medium text-slate-500 md:inline-flex">
					HTMX + Templ
				</span>
			</div>
			<nav class="flex items-center gap-2 text-sm font-medium text-slate-600">
				<a href="/" class="rounded-full px-3 py-1.5 transition hover:bg-slate-100 hover:text-slate-900">Home</a>
				<a href="/docs" class="rounded-full px-3 py-1.5 transition hover:bg-slate-100 hover:text-slate-900">Docs</a>
			</nav>
			<a href="/docs" class="inline-flex items-center justify-center rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-slate-800">
				Get started
			</a>
		</div>
	</section>
}
