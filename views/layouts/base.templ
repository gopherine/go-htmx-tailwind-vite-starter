package layouts

import (
	"github.com/golang_starter/internal/assets"
	"github.com/golang_starter/views/components"
)

templ Base(content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta http-equiv="X-UA-Compatible" content="IE=edge"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>teddy</title>
			<link rel="icon" type="image/x-icon" href="/public/favicon.ico"/>
			<link rel="stylesheet" type="text/css" href="/public/assets/global.css"/>
			<script type="module" src={ assets.AssetPath("app") }></script>
			<script src="https://unpkg.com/htmx.org@1.9.12"></script>
		</head>
		<body hx-boost="true" hx-target="#app" hx-swap="innerHTML">
			@components.Navigation()
			<main id="app">
				@content
			</main>
		</body>
	</html>
}
